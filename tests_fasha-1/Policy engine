class PolicyEngine:

    def evaluate(self, context: dict):
        """
        Evaluate a transaction context dict and return allow/block decision.
        Used by Phase-1 tests.
        """
        risk = context.get("risk", "low")
        value = context.get("value", 0)

        if risk == "high" or value >= 100_000:
            return "block"
        if risk == "low" and value < 1_000:
            return "allow"
        return "warn"

    def apply(self, decision: dict, executor: str):
        """Route to alternative executor based on policy decision."""
        if decision["action"] == "BLOCK":
            return "consensus_executor"
        if executor == "financial_executor" and decision["action"] == "WARN":
            return "audit_executor"
        return executor
