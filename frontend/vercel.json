{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "VITE_CONTRACT_ADDRESS": "@genroute_contract_address",
    "VITE_RPC_URL": "@genroute_rpc_url"
  }
}
